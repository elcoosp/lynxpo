{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "cssModules": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/modules/device/src/index.ts",
        "packages/tools/nmb/fixtures/out.ts"
      ],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off"
          }
        }
      },
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "useImportType": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/plugins/ktts/src/index.ts",
        "packages/tools/aps/src/index-legacy.ts",
        "packages/tools/aps/src/index.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noAssignInExpressions": "off",
            "noImplicitAnyLet": "off"
          }
        }
      }
    }
  ]
}
