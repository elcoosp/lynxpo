{
  "name": "@lynxpo/style-dict-rsbuild-plugin",
  "version": "0.0.0",
  "repository": "https://github.com/rspack-contrib/rsbuild-plugin-template",
  "license": "MIT",
  "description": "style-dict-rsbuild-plugin rsbuild plugin",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "lint": "biome check .",
    "lint:ox": "oxlint",
    "lint:write": "biome check . --write",
    "prepare": "npm run build",
    "test": "playwright test",
    "bump": "npx bumpp"
  },
  "dependencies": {
    "glob": "^13.0.0",
    "sd-tailwindcss-transformer": "^2.1.0",
    "style-dictionary": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@playwright/test": "^1.51.1",
    "@rsbuild/core": "^2.0.0",
    "@rslib/core": "^0.23.0",
    "@types/node": "^24.0.0",
    "playwright": "^1.51.1",
    "typescript": "^7.0.0",
    "@elcoosp-configs/rslib": "2.1.0",
    "@rspack/tracing": "^1.2.8",
    "@tsconfig/node24": "^24.0.0",
    "@tsconfig/strictest": "^2.0.5",
    "oxlint": "^1.0.0"
  },
  "peerDependencies": {
    "@rsbuild/core": "2.2.1"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.25.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
