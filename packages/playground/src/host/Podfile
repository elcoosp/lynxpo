# lynxpo host app — engine from published channels, no vendored lynx checkout.
source 'https://cdn.cocoapods.org/'
source 'https://github.com/lynx-family/Specs.git'

project './LynxpoHost.xcodeproj'

# Official autolink plugin (published gem, 4.2.0 — replaces the copy that used
# to be loaded from the old vendored engine checkout).
plugin 'cocoapods-lynx-library'

platform :ios, '12.0'

install! 'cocoapods',
         :deterministic_uuids => false,
         :lock_pod_sources => false,
         :generate_multiple_pod_projects => true,
         :incremental_installation => true,
         :warn_for_multiple_pod_sources => false

post_install do |installer|
  installer.pod_target_subprojects.flat_map { |p| p.targets }.each do |t|
    t.build_configurations.each do |c|
      c.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
    end
  end
end

target 'LynxpoHost' do
  use_frameworks! :linkage => :static

  # Engine — pinned to one version line across pods, Maven and Explorer.
  pod 'Lynx', '4.2.0', :subspecs => ['Framework']
  # Lynx pulls these transitively; pin them to the same line so CocoaPods does
  # not drift to the newest major/minor published in the Specs repo.
  pod 'LynxBase', '4.2.0', :subspecs => ['Framework']
  pod 'LynxServiceAPI', '4.2.0', :subspecs => ['Core']
  # JS runtime (official integration pins PrimJS from the CDN):
  pod 'PrimJS', '4.2.1', :subspecs => ['quickjs', 'napi']

  # Uncomment when the host uses image/log/http services:
  # pod 'LynxService', '4.2.0', :subspecs => ['Image', 'Log', 'Http']
  # pod 'SDWebImage', '5.15.5'
  # pod 'SDWebImageWebPCoder', '0.11.0'

  # Richer element set maintained by the Lynx team (optional):
  # pod 'XElement', '4.2.0'

  # Autolink: scans node_modules for lynx.lib.json and generates the
  # registry pod into generated/lynx-library (tracked, same path as before).
  use_lynx_library!(:output_dir => File.join(__dir__, 'generated/lynx-library'))
end
