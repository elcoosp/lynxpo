{
  "name": "@lynxpo/tools-dx",
  "author": "elcoosp <elcoosp@gmail.com>",
  "version": "0.0.0",
  "type": "module",
  "description": "Unified local dev experience (dx) for lynxpo: perms, types, build, inject, ios, android, doctor",
  "bin": {
    "lynxpo": "./dist/index.js"
  },
  "main": "./dist/cjs/index.cjs",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.cjs",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "check": "biome check --write",
    "fmt": "biome format --write",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@elcoosp-configs/rslib": "2.1",
    "@rslib/core": "^0.23.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0",
    "vitest": "^2.1.0"
  }
}
