import Foundation
import NMBSwiftInspect
import SwiftSyntax
import SwiftSyntaxMacros
import Testing

@testable import NMBSwiftInspect

// Base test factory to create a class with the @Codable macro using SwiftSyntax
func makeTypedClass(
    builder: () -> String
) -> ClassInfo {
    let classCode = """
        @Typed
        class TestClass {
            \(builder())
        }
        """

    // Expand the macro using SwiftSyntax testing utilities
    let parsed = try! SyntaxParser.parse(source: classCode)
    let expanded = parsed.expand(
        macros: ["Typed": TypedMacro.self],
        in: .testContext
    )

    // Extract the generated type info using Macro Toolkit's type destructuring
    guard let classDecl = expanded.find(ClassDeclSyntax.self),
        let typeInfo = try? ClassInfo.from(classDecl)
    else {
        fatalError("Failed to extract ClassInfo from expanded macro")
    }

    return typeInfo
}

@Suite("NMBSwiftInspect")
struct NMBSwiftInspectTests {

    // MARK: - TypedMacro Tests

    @Test("TypedMacro should generate type info for a basic class")
    func testTypedMacroBasic() throws {
        // When
        let classInfo = makeTypedClass {
            """
            @LynxMethod
            func simpleMethod() -> String {
                return "test"
            }
            """
        }

        // Then
        #expect(classInfo.name == "TestClass")
        #expect(classInfo.methods.count == 1)
        #expect(classInfo.methods[0].name == "simpleMethod")
    }

    @Test("TypedMacro should include Codable nested types")
    func testTypedMacroWithserializableTypes() throws {
        // When
        let classInfo = makeTypedClass {
            """
            @Codable
            struct NestedStruct {
                let name: String
                let count: Int
            }

            @LynxMethod
            func methodUsingNestedType() -> NestedStruct {
                return NestedStruct(name: "test", count: 1)
            }
            """
        }

        // Then
        #expect(classInfo.serializableTypes.count == 1)
        #expect(classInfo.serializableTypes[0].name == "NestedStruct")
        #expect(
            classInfo.serializableTypes[0].propertyDefinitions.map(\.name) == ["name", "count"])
    }

    // MARK: - LynxMethod Tests

    @Test("LynxMethod should include only annotated methods")
    func testLynxMethodAnnotation() throws {
        // When
        let classInfo = makeTypedClass {
            """
            @LynxMethod
            func annotatedMethod() -> Int {
                return 42
            }

            func unannotatedMethod() -> Int {
                return 24
            }
            """
        }

        // Then
        #expect(classInfo.methods.count == 1)
        #expect(classInfo.methods[0].name == "annotatedMethod")
    }

    @Test("LynxMethod should correctly process parameters")
    func testLynxMethodWithParameters() throws {
        // When
        let classInfo = makeTypedClass {
            """
            @LynxMethod
            func methodWithParams(name: String, count: Int) -> Bool {
                return true
            }
            """
        }

        // Then
        let method = try #require(classInfo.methods.first)
        #expect(method.parameters.count == 2)
        #expect(method.parameters[0].name == "name")
        #expect(method.parameters[1].name == "count")
    }

    // MARK: - TsRetInto Tests

    @Test("TsRetInto should override return type hints")
    func testTsRetIntoAnnotation() throws {
        // When
        let classInfo = makeTypedClass {
            """
            @LynxMethod
            @TsRetInto("Array<string>")
            func convertedReturnType() -> [String] {
                return ["test"]
            }
            """
        }

        // Then
        let method = try #require(classInfo.methods.first)
        #expect(method.returnType.customReturnHint == "Array<string>")
    }

    // MARK: - Type Processing Tests

    @Test("Processor should handle optional types correctly")
    func testOptionalTypeProcessing() throws {
        // When
        let classInfo = makeTypedClass {
            """
            @LynxMethod
            func methodWithOptional() -> String? {
                return nil
            }
            """
        }

        // Then
        let method = try #require(classInfo.methods.first)
        #expect(method.returnType.isNullable == true)
    }

    @Test("Processor should handle enums correctly")
    func testEnumProcessing() throws {
        // When
        let classInfo = makeTypedClass {
            """
            @Codable
            enum TestEnum: String {
                case first
                case second
                case third
            }

            @LynxMethod
            func getEnum() -> TestEnum {
                return .first
            }
            """
        }

        // Then
        let enumType = try #require(classInfo.serializableTypes.first)
        #expect(enumType.kind == .ENUM)
        #expect(enumType.propertyDefinitions.map(\.name) == ["first", "second", "third"])
    }

    // MARK: - Async Method Tests

    @Test("Processor should detect async methods correctly")
    func testAsyncMethodDetection() throws {
        // When
        let classInfo = makeTypedClass {
            """
            @LynxMethod
            func synchronousMethod() -> Int {
                return 1
            }

            @LynxMethod
            async func asynchronousMethod() -> Int {
                return 2
            }
            """
        }

        // Then
        let asyncMethods = classInfo.methods.filter(\.isAsync)
        let syncMethods = classInfo.methods.filter { !$0.isAsync }
        #expect(asyncMethods.count == 1)
        #expect(syncMethods.count == 1)
        #expect(asyncMethods[0].name == "asynchronousMethod")
    }

    // MARK: - Default Values Tests

    @Test("Processor should detect parameters with default values")
    func testParameterDefaultValues() throws {
        // When
        let classInfo = makeTypedClass {
            """
            @LynxMethod
            func methodWithDefaults(required: String, optional: Int = 42) -> Bool {
                return true
            }
            """
        }

        // Then
        let params = try #require(classInfo.methods.first?.parameters)
        #expect(params[0].hasDefaultValue == false)
        #expect(params[1].hasDefaultValue == true)
    }

    // MARK: - Combined Feature Tests

    @Test("All features should work together in a complex class")
    func testComplexClassWithAllFeatures() throws {
        // When
        let classInfo = makeTypedClass {
            """
            @Codable
            enum Priority: String {
                case low
                case medium
                case high
            }

            @Codable
            struct Task {
                let id: String
                let description: String
                let priority: Priority
            }

            @LynxMethod
            public func createTask(id: String, description: String, priority: Priority = .medium) -> Task {
                return Task(id: id, description: description, priority: priority)
            }

            @LynxMethod
            @TsRetInto("Array<Task>")
            async func fetchTasks() -> [Task] {
                return []
            }

            @LynxMethod
            private func internalHelperMethod() {
                // Does nothing
            }
            """
        }

        // Then
        #expect(classInfo.serializableTypes.count == 2)
        #expect(classInfo.methods.count == 3)

        let taskMethod = try #require(classInfo.methods.first { $0.name == "createTask" })
        #expect(taskMethod.visibility == .PUBLIC)

        let asyncMethod = try #require(classInfo.methods.first { $0.name == "fetchTasks" })
        #expect(asyncMethod.isAsync == true)

        let privateMethod = try #require(
            classInfo.methods.first { $0.name == "internalHelperMethod" })
        #expect(privateMethod.visibility == .PRIVATE)
    }
}
